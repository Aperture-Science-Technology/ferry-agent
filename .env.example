DATABASE_URL=postgresql+asyncpg://ferry:ferry@localhost:5432/ferry_agent
SQL_ECHO=false

# Laisser vide pour activer le mode dev (auth via header X-Dev-User).
# Ne jamais laisser vide en production.
CLERK_ISSUER=
CLERK_AUDIENCE=

LIBRARY_STORAGE_DIR=./data/library
TEMP_DIR=./data/tmp

MAX_FETCH_BYTES=209715200
PAIRING_TOKEN_TTL_MINUTES=15
GATEWAY_ONLINE_SECONDS=60
GATEWAY_SEARCH_WAIT_SECONDS=15
VIRUSTOTAL_API_KEY=

# Send-to-Kindle / envoi email (tier A). Laisser SMTP_USER/SMTP_PASSWORD
# vides desactive l'envoi sans faire planter l'app.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

PUBLIC_BASE_URL=https://ferry-agent.aperture-agency.org

APP_ENV=development
