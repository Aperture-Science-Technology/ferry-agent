DATABASE_URL=postgresql+asyncpg://ferry:ferry@localhost:5432/ferry_agent
SQL_ECHO=false

# Laisser vide pour activer le mode dev (auth via header X-Dev-User).
# Ne jamais laisser vide en production.
CLERK_ISSUER=
CLERK_AUDIENCE=

LIBRARY_STORAGE_DIR=./data/library
TEMP_DIR=./data/tmp

MAX_FETCH_BYTES=209715200
PAIRING_TOKEN_TTL_MINUTES=15
GATEWAY_ONLINE_SECONDS=60
GATEWAY_SEARCH_WAIT_SECONDS=15
VIRUSTOTAL_API_KEY=

APP_ENV=development
