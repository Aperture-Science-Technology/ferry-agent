DATABASE_URL=postgresql+asyncpg://ferry:ferry@localhost:5432/ferry_agent
SQL_ECHO=false

# Laisser vide pour activer le mode dev (auth via header X-Dev-User).
# Ne jamais laisser vide en production.
CLERK_ISSUER=
CLERK_AUDIENCE=

LIBRARY_STORAGE_DIR=./data/library
TEMP_DIR=./data/tmp

MAX_FETCH_BYTES=209715200
PAIRING_TOKEN_TTL_MINUTES=15
GATEWAY_ONLINE_SECONDS=60
GATEWAY_SEARCH_WAIT_SECONDS=15
VIRUSTOTAL_API_KEY=

# Send-to-Kindle / envoi email (tier A). Laisser SMTP_USER/SMTP_PASSWORD
# vides desactive l'envoi sans faire planter l'app.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

PUBLIC_BASE_URL=https://ferry-agent.aperture-agency.org

# Livraison tier B (Dropbox / Google Drive). Laisser vide desactive le
# provider correspondant (l'endpoint /link renvoie 503 plutot que de planter).
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REDIRECT_URI=https://ferry-agent.aperture-agency.org/api/v1/devices/{id}/link/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ferry-agent.aperture-agency.org/api/v1/devices/{id}/link/callback

# Chiffrement au repos des tokens cloud (Device.link_ref). OBLIGATOIRE des
# qu'un compte Dropbox/Drive est lie. Perdre cette cle rend tous les tokens
# illisibles (l'API expose cloud_linked=false ; il faut relier). Plusieurs
# cles separees par des virgules = rotation (la premiere chiffre).
# Generer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

APP_ENV=development

# OAuth Clerk pour le serveur MCP (identité utilisateur obligatoire).
CLERK_DOMAIN=
CLERK_OAUTH_CLIENT_ID=
CLERK_OAUTH_CLIENT_SECRET=
MCP_BASE_URL=https://ferry-agent.aperture-agency.org
