# URL publique de ce site (utilisee pour les liens absolus, metadata, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL publique du core FastAPI, si le web a besoin d'y taper directement
# (hors proxy same-origin /api/v1). Optionnel si BACKEND_INTERNAL_URL suffit.
NEXT_PUBLIC_BACKEND_BASE=http://localhost:8000

# Version Gateway publiee (semver sans v, ex. 1.2.3). Vide = fallback page Releases.
# Doit correspondre a un tag GitHub v* avec ferry-gateway-<ver>-{amd64,arm64}.tar.gz.
# NEXT_PUBLIC_GATEWAY_RELEASE_VERSION=

# URL interne (reseau Docker/VPC) du core FastAPI, utilisee par:
# - les rewrites Next (next.config.ts) qui exposent /api/v1/* en same-origin
# - les fetch() effectues depuis les server components (lib/api.ts)
BACKEND_INTERNAL_URL=http://ferry-agent-core:8000

# Clerk (dashboard.clerk.com -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxx
