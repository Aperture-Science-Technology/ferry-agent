# URL du core Ferry Agent (interne Docker ou réseau local)
FERRY_CORE_URL=http://ferry-core:8000

# Port d'écoute du serveur MCP HTTP
PORT=8000

# OAuth Clerk — identité utilisateur obligatoire (pas de compte-service).
# mcp_auth_enabled vaut True par défaut ; interdit à False si APP_ENV=production.
CLERK_DOMAIN=
CLERK_OAUTH_CLIENT_ID=
CLERK_OAUTH_CLIENT_SECRET=
MCP_BASE_URL=https://ferry-agent.aperture-agency.org
