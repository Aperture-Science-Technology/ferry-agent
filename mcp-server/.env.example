# URL du core Ferry Agent (interne Docker ou réseau local)
FERRY_CORE_URL=http://ferry-core:8000

# Clé API serveur partagée avec le core (MCP_API_KEY du côté core).
# Doit être identique des deux côtés. Laisser vide = refus par le core.
MCP_API_KEY=changeme-secret-key

# Port d'écoute du serveur MCP HTTP
PORT=8000
